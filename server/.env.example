# Server
NODE_ENV=development
PORT=5000
# Atlas URI, local mongodb://127.0.0.1:27017/theruux, or "memory"
MONGODB_URI=mongodb://127.0.0.1:27017/theruux
JWT_ACCESS_SECRET=change-me-access-secret-min-16
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CLIENT_URL=http://localhost:5173
# Multiple origins: CLIENT_URL=http://localhost:5173,http://localhost:5174
PUBLIC_API_URL=http://localhost:5000
COOKIE_SECURE=false

# Seed (optional overrides)
SEED_ADMIN_EMAIL=admin@theruux.com
SEED_ADMIN_PASSWORD=TheruuxAdmin1!

# Commerce defaults
LOW_STOCK_THRESHOLD=5
SHIPPING_STANDARD_INR=0

# Razorpay — mock checkout when unset; webhook needs public URL + secret in staging
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary — required in production; local /uploads fallback in development
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=theruux

# Email — Resend preferred; SMTP fallback. Logs to console when unset.
EMAIL_FROM=TheRuux <orders@theruux.com>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional error tracking
SENTRY_DSN=
