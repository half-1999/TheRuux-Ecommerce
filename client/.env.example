# Dev: /api is proxied to the local server (vite.config.js). No CORS.
# Production builds use client/.env.production:
# https://theruux-ecommerce-jbpe.onrender.com/api
VITE_API_URL=/api
VITE_INSTAGRAM_URL=https://instagram.com
# Optional — leave blank to disable
VITE_SENTRY_DSN=
# Google Analytics 4 measurement id, for example G-ABC123. Leave blank until the property exists.
VITE_GA_MEASUREMENT_ID=
# Google Search Console HTML-tag verification value. Leave blank until Search Console gives you one.
VITE_GSC_VERIFICATION=
